# Public site URL (no trailing slash)
NEXT_PUBLIC_SERVER_URL=https://your-domain.com
SERVER_URL=https://your-domain.com

# Long random string for Payload auth/encryption
PAYLOAD_SECRET=change-me-to-a-long-random-string

# SQLite database file (shared hosting friendly — no separate DB server)
DATABASE_URI=file:./data/glic.db

# First admin (used by npm run seed)
SEED_ADMIN_EMAIL=admin@glministries.org
SEED_ADMIN_PASSWORD=ChangeMeNow!

# Optional port for `npm start` (cPanel Node apps often set PORT automatically)
PORT=3000
